{
  "Auth": {
    "ExposeResetToken": true
  },
  "Jwt": {
    "Key": "CHANGE_ME_TO_A_32_BYTE_OR_LONGER_SECRET",
    "Issuer": "eMarket",
    "Audience": "eMarket.Api",
    "ExpirationInMinutes": 120
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=eMarket_Dev;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:7172",
      "http://localhost:5270"
    ]
  },
  "Swagger": {
    "Enabled": true
  },
  "Payments": {
    "Provider": "Iyzico",
    "AllowedReturnHosts": [
      "localhost"
    ],
    "Iyzico": {
      "ApiKey": "",
      "SecretKey": "",
      "BaseUrl": "https://sandbox-api.iyzipay.com"
    }
  },
  "Security": {
    "UseHttpsRedirection": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
